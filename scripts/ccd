#!/usr/bin/env bash
set -euo pipefail

_cc_script_path="${BASH_SOURCE[0]}"
while [[ -L "${_cc_script_path}" ]]; do
  _cc_link="$(readlink "${_cc_script_path}")"
  if [[ "${_cc_link}" = /* ]]; then
    _cc_script_path="${_cc_link}"
  else
    _cc_script_path="$(cd "$(dirname "${_cc_script_path}")" && pwd)/${_cc_link}"
  fi
done
_cc_script_dir="$(cd "$(dirname "${_cc_script_path}")" && pwd)"
_cc_lib_loaded=0
for _cc_lib in "${_cc_script_dir}/lib/cc-common.sh" "${HOME}/.local/share/cc-router/lib/cc-common.sh"; do
  if [[ -f "${_cc_lib}" ]]; then
    # shellcheck source=/dev/null
    source "${_cc_lib}"
    _cc_lib_loaded=1
    break
  fi
done
if [[ "${_cc_lib_loaded}" -ne 1 ]]; then
  echo "cc-router: lib/cc-common.sh not found (re-run ./install.sh)" >&2
  exit 1
fi

model='deepseek-v4-pro[1m]'
haiku_model='deepseek-v4-flash'
max_output='65536'
autocompact_pct='0'
worktree_name=''
use_current_dir='0'
args=()

die() {
  echo "$1" >&2
  exit "${2:-1}"
}

is_valid_worktree_name() {
  local name="$1"
  [[ -n "${name}" ]] && [[ "${name}" =~ ^[A-Za-z0-9._-]+$ ]]
}

ensure_worktree_path() {
  local name="$1"
  local repo_root="$2"
  local target_dir="${repo_root}/.worktrees/${name}"
  local branch_name="worktree/${name}"

  mkdir -p "${repo_root}/.worktrees"

  if [[ -d "${target_dir}" ]]; then
    if git -C "${target_dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      local target_root
      target_root="$(git -C "${target_dir}" rev-parse --show-toplevel 2>/dev/null || true)"
      if [[ "${target_root}" == "${target_dir}" ]]; then
        echo "${target_dir}"
        return 0
      fi
    fi
    die "Worktree path already exists but is not a reusable git worktree: ${target_dir}"
  fi

  if git -C "${repo_root}" show-ref --verify --quiet "refs/heads/${branch_name}"; then
    git -C "${repo_root}" worktree add "${target_dir}" "${branch_name}" >/dev/null
  else
    git -C "${repo_root}" worktree add -b "${branch_name}" "${target_dir}" >/dev/null
  fi
  echo "${target_dir}"
}

show_help() {
  cat <<'EOF'
ccd - Start Claude Code routed to DeepSeek

Usage:
  ccd [options] [-- claude args...]
  ccd resume [claude args...]
  ccd doctor
  ccd setup
  ccd prompt [--print-prompt]
  ccd -h | --help

Options:
  -h, --help                 Show help
  -C, --current, --here      Keep current directory
  --worktree <name>          Run in .worktrees/<name> (requires clean git repo)
  --model <id>               Default: deepseek-v4-pro[1m]
  --haiku-model <id>         Default: deepseek-v4-flash
  --max-output <n>           Default: 65536
  --autocompact-pct <n>      Default: 0 (unset override)

Subcommands:
  doctor                     Run environment checks
  setup                      Interactive DEEPSEEK_API_KEY setup
  prompt | dramatic-prompt   Show the AI-assisted setup prompt template
EOF
}

resolve_prompt_template() {
  if [[ -n "${CCD_PROMPT_TEMPLATE:-}" ]]; then
    if [[ -f "${CCD_PROMPT_TEMPLATE}" ]]; then
      printf '%s\n' "${CCD_PROMPT_TEMPLATE}"
      return 0
    fi
    echo "CCD_PROMPT_TEMPLATE is set but file does not exist: ${CCD_PROMPT_TEMPLATE}" >&2
    return 1
  fi

  local script_path="${BASH_SOURCE[0]}"
  while [[ -L "${script_path}" ]]; do
    local link_target
    link_target="$(readlink "${script_path}")"
    if [[ "${link_target}" = /* ]]; then
      script_path="${link_target}"
    else
      script_path="$(cd "$(dirname "${script_path}")" && pwd)/${link_target}"
    fi
  done
  local script_dir
  script_dir="$(cd "$(dirname "${script_path}")" && pwd)"

  local candidates=(
    "${script_dir}/../docs/dramatic-prompt.md"
    "${HOME}/.local/share/ccdeepseek/dramatic-prompt.md"
    "$(pwd)/docs/dramatic-prompt.md"
  )
  local c
  for c in "${candidates[@]}"; do
    if [[ -f "${c}" ]]; then
      printf '%s\n' "$(cd "$(dirname "${c}")" && pwd)/$(basename "${c}")"
      return 0
    fi
  done
  return 1
}

run_prompt_subcommand() {
  local print_prompt=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print-prompt|--print)
        print_prompt=1; shift ;;
      -h|--help)
        cat <<'EOF'
ccd prompt - Show the dramatic prompt template for AI-assisted setup

Usage:
  ccd prompt                  Print the template path and copy/paste hints
  ccd prompt --print-prompt   Print the full template content to stdout

Template lookup order:
  1. $CCD_PROMPT_TEMPLATE (if set and exists)
  2. <script-dir>/../docs/dramatic-prompt.md  (in-repo layout)
  3. ~/.local/share/ccdeepseek/dramatic-prompt.md  (installed layout)
  4. ./docs/dramatic-prompt.md  (current working directory)
EOF
        return 0 ;;
      *)
        echo "Unknown option for 'ccd prompt': $1" >&2
        echo "Run 'ccd prompt --help' for usage." >&2
        return 2 ;;
    esac
  done

  local template
  if ! template="$(resolve_prompt_template)"; then
    cat >&2 <<'EOF'
Could not locate dramatic-prompt.md template.

Either:
  - set CCD_PROMPT_TEMPLATE=/absolute/path/to/dramatic-prompt.md
  - or place the file at ~/.local/share/ccdeepseek/dramatic-prompt.md
  - or run this command from a checkout that contains docs/dramatic-prompt.md
EOF
    return 1
  fi

  if [[ "${print_prompt}" -eq 1 ]]; then
    cat "${template}"
    return 0
  fi

  cat <<EOF
Dramatic prompt template:
  ${template}

Show full content:
  ccd prompt --print-prompt

Copy to clipboard:
  ccd prompt --print-prompt | xclip -selection clipboard   # Linux
  ccd prompt --print-prompt | pbcopy                       # macOS
  ccd prompt --print-prompt | clip.exe                     # Windows / WSL

Then paste it into any AI coding agent (Claude Code, Codex, Cursor, ...) and follow the steps.
EOF
}

run_setup() {
  local key
  local choice
  local doctor_choice
  local profile="${HOME}/.bashrc"
  local export_line
  local has_existing='0'
  local line
  local tmp_file

  echo "DeepSeek setup"
  echo
  read -r -p "Enter DEEPSEEK_API_KEY: " key
  if [[ -z "${key}" ]]; then
    echo "DEEPSEEK_API_KEY cannot be empty." >&2
    exit 2
  fi

  echo
  echo "Choose persistence:"
  echo "  1) Current session only"
  echo "  2) Write to ~/.bashrc"
  read -r -p "Select [1/2]: " choice

  export_line="export DEEPSEEK_API_KEY=\"${key}\""
  case "${choice}" in
    1)
      echo
      echo "Current session only selected."
      echo "Run this command in your shell:"
      echo "${export_line}"
      ;;
    2)
      touch "${profile}"
      while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ "${line}" == export\ DEEPSEEK_API_KEY=* ]]; then
          has_existing='1'
          break
        fi
      done < "${profile}"

      if [[ "${has_existing}" == '1' ]]; then
        # Replace existing export line to avoid duplicates/stale value.
        tmp_file="$(mktemp)"
        while IFS= read -r line || [[ -n "${line}" ]]; do
          if [[ "${line}" == export\ DEEPSEEK_API_KEY=* ]]; then
            printf '%s\n' "${export_line}" >> "${tmp_file}"
          else
            printf '%s\n' "${line}" >> "${tmp_file}"
          fi
        done < "${profile}"
        mv "${tmp_file}" "${profile}"
        echo "Updated existing DEEPSEEK_API_KEY in ${profile}."
      else
        printf '\n%s\n' "${export_line}" >> "${profile}"
        echo "Appended DEEPSEEK_API_KEY to ${profile}."
      fi
      export DEEPSEEK_API_KEY="${key}"
      echo "Applied key to current shell process."
      ;;
    *)
      echo "Invalid selection: ${choice}" >&2
      exit 2
      ;;
  esac

  echo
  echo "Next steps:"
  echo "  1) Run: ccd doctor"
  echo "  2) Run: ccd"
  if command -v claude >/dev/null 2>&1; then
    echo
    read -r -p "Run 'ccd doctor' now? [Y/n]: " doctor_choice
    if [[ -z "${doctor_choice:-}" || "${doctor_choice}" == "y" || "${doctor_choice}" == "Y" ]]; then
      if [[ -n "${DEEPSEEK_API_KEY:-}" ]]; then
        echo
        echo "Running ccd doctor..."
        echo "OK: DEEPSEEK_API_KEY detected."
        echo "OK: claude found at $(command -v claude)"
      else
        echo "Cannot run doctor automatically in this shell context."
        echo "Please run manually: ccd doctor"
      fi
    fi
  else
    echo
    echo "claude not found yet. Install first, then run: ccd doctor"
  fi
}

if [[ $# -eq 0 ]]; then
  :
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|help)
      show_help
      exit 0
      ;;
    doctor)
      issues=0

      echo "== ccd doctor =="
      echo "Target: DeepSeek routing mode"
      echo

      if [[ -n "${DEEPSEEK_API_KEY:-}" ]]; then
        echo "OK: DEEPSEEK_API_KEY detected in current shell"
      else
        issues=1
        echo "FAIL: DEEPSEEK_API_KEY is missing"
        echo "Fix (current shell): export DEEPSEEK_API_KEY=\"your_key\""
        echo "Fix (persist bash): echo 'export DEEPSEEK_API_KEY=\"your_key\"' >> ~/.bashrc && . ~/.bashrc"
      fi
      echo

      if command -v claude >/dev/null 2>&1; then
        echo "OK: claude found at $(command -v claude)"
      else
        issues=1
        echo "FAIL: claude not found in PATH"
        echo "Fix (npm): npm install -g @anthropic-ai/claude-code"
        echo "Fix (pnpm): pnpm add -g @anthropic-ai/claude-code"
      fi
      echo

      echo "Expected env behavior for ccd:"
      echo "- ANTHROPIC_BASE_URL should be injected only when launching ccd"
      echo "- ANTHROPIC_AUTH_TOKEN should be injected only when launching ccd"
      echo "- Outside running ccd, these two vars are usually empty (this is normal)"

      if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
        if [[ "${ANTHROPIC_BASE_URL}" == "https://api.deepseek.com/anthropic" ]]; then
          echo "OK: current ANTHROPIC_BASE_URL matches ccd runtime value"
        else
          issues=1
          echo "WARN: current ANTHROPIC_BASE_URL is unexpected: ${ANTHROPIC_BASE_URL}"
          echo "Fix: unset ANTHROPIC_BASE_URL"
        fi
      else
        echo "OK: ANTHROPIC_BASE_URL not preset in shell (normal for ccd)"
      fi

      if [[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
        if [[ -n "${DEEPSEEK_API_KEY:-}" && "${ANTHROPIC_AUTH_TOKEN}" == "${DEEPSEEK_API_KEY}" ]]; then
          echo "OK: current ANTHROPIC_AUTH_TOKEN matches DEEPSEEK_API_KEY"
        else
          issues=1
          echo "WARN: current ANTHROPIC_AUTH_TOKEN does not match DEEPSEEK_API_KEY (or key missing)"
          echo "Fix: unset ANTHROPIC_AUTH_TOKEN"
        fi
      else
        echo "OK: ANTHROPIC_AUTH_TOKEN not preset in shell (normal for ccd)"
      fi
      echo

      echo "MCP tool context-bloat protection (ENABLE_TOOL_SEARCH):"
      if [[ -z "${CCD_TOOL_SEARCH+x}" ]]; then
        echo "  ccd will inject ENABLE_TOOL_SEARCH=true (default)"
        echo "  This forces deferred MCP tool loading; prevents the 30k+ token messages bloat"
        echo "  See docs/SETUP-NOTES.md (section 1) for the full root-cause analysis"
      elif [[ -z "${CCD_TOOL_SEARCH}" ]]; then
        echo "  ccd will NOT inject ENABLE_TOOL_SEARCH (CCD_TOOL_SEARCH explicitly empty)"
        echo "  This restores pre-fix behavior (eagerly loads all MCP tool schemas into messages)"
        echo "  Re-enable with: unset CCD_TOOL_SEARCH"
      else
        echo "  ccd will inject ENABLE_TOOL_SEARCH=${CCD_TOOL_SEARCH} (from CCD_TOOL_SEARCH)"
      fi
      echo

      if [[ "${issues}" -eq 0 ]]; then
        echo "Doctor result: healthy"
      else
        echo "Doctor result: action required (see Fix commands above)"
      fi
      exit 0
      ;;
    setup)
      run_setup
      exit 0
      ;;
    prompt|dramatic-prompt)
      shift
      run_prompt_subcommand "$@" || exit $?
      exit 0
      ;;
    -C|--here|--current)
      use_current_dir='1'
      shift
      ;;
    --worktree)
      if [[ $# -lt 2 ]]; then
        die "--worktree requires a value" 2
      fi
      worktree_name="$2"; shift 2
      ;;
    --model)
      if [[ $# -lt 2 ]]; then
        die "--model requires a value" 2
      fi
      model="$2"; shift 2
      ;;
    --haiku-model)
      if [[ $# -lt 2 ]]; then
        die "--haiku-model requires a value" 2
      fi
      haiku_model="$2"; shift 2
      ;;
    --max-output)
      if [[ $# -lt 2 ]]; then
        die "--max-output requires a value" 2
      fi
      max_output="$2"; shift 2
      ;;
    --autocompact-pct)
      if [[ $# -lt 2 ]]; then
        die "--autocompact-pct requires a value" 2
      fi
      autocompact_pct="$2"; shift 2
      ;;
    resume)
      args+=("-c")
      shift
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do args+=("$1"); shift; done
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ -n "${worktree_name}" ]] && [[ "${use_current_dir}" == "1" ]]; then
  die "--worktree cannot be used with --current/--here" 2
fi

if [[ -n "${worktree_name}" ]]; then
  if ! is_valid_worktree_name "${worktree_name}"; then
    die "Invalid worktree name: use only letters, numbers, '.', '_' or '-'"
  fi

  if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    die "--worktree requires running inside a git repository"
  fi

  if [[ -n "$(git -C "${repo_root}" status --porcelain)" ]]; then
    die "Refusing to create/reuse worktree from a dirty repo. Commit/stash changes first."
  fi

  worktree_dir="$(ensure_worktree_path "${worktree_name}" "${repo_root}")"
  cd "${worktree_dir}"
fi

if ! command -v claude >/dev/null 2>&1; then
  die "Claude Code CLI not found. Install first: npm install -g @anthropic-ai/claude-code"
fi

if [[ -z "${DEEPSEEK_API_KEY:-}" ]]; then
  die "Set DEEPSEEK_API_KEY before running ccd."
fi

export ANTHROPIC_BASE_URL='https://api.deepseek.com/anthropic'
export ANTHROPIC_AUTH_TOKEN="${DEEPSEEK_API_KEY}"
export ANTHROPIC_MODEL="${model}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${model}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${model}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${haiku_model}"
export CLAUDE_CODE_SUBAGENT_MODEL="${haiku_model}"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${max_output}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='1'
export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK='1'
export CLAUDE_CODE_EFFORT_LEVEL='max'
# Re-enable deferred MCP tool loading (disabled by Claude Code >= 2.1.70
# for non-first-party hosts). Without this, all MCP tool schemas load
# upfront and silently consume context. See docs/SETUP-NOTES.md and
# https://github.com/anthropics/claude-code/issues/31936
# Override with CCD_TOOL_SEARCH= (disable) or CCD_TOOL_SEARCH=auto (threshold).
ccd_tool_search="${CCD_TOOL_SEARCH-true}"
if [[ -n "${ccd_tool_search}" ]]; then
  export ENABLE_TOOL_SEARCH="${ccd_tool_search}"
fi
cc_router_export_cache_prompt_env
if [[ "${autocompact_pct}" != "0" ]]; then
  export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="${autocompact_pct}"
fi

cc_router_exec_claude "${args[@]}"
