#!/usr/bin/env bash
set -euo pipefail

_ccr_script_path="${BASH_SOURCE[0]}"
while [[ -L "${_ccr_script_path}" ]]; do
  _ccr_link="$(readlink "${_ccr_script_path}")"
  if [[ "${_ccr_link}" = /* ]]; then
    _ccr_script_path="${_ccr_link}"
  else
    _ccr_script_path="$(cd "$(dirname "${_ccr_script_path}")" && pwd)/${_ccr_link}"
  fi
done
_ccr_script_dir="$(cd "$(dirname "${_ccr_script_path}")" && pwd)"

# Resolve the payload repo root for `ccr remote install`:
#   - Running from a source checkout (scripts/../install.sh exists) → that checkout root.
#   - Installed (~/.local/bin/ccr) → the share dir, which install.sh fills with the payload.
CC_ROUTER_REPO_DIR="$(cd "${_ccr_script_dir}/.." && pwd)"
if [[ ! -f "${CC_ROUTER_REPO_DIR}/install.sh" && -f "${HOME}/.local/share/cc-router/install.sh" ]]; then
  CC_ROUTER_REPO_DIR="${HOME}/.local/share/cc-router"
fi
export CC_ROUTER_REPO_DIR

_ccr_load_lib() {
  local name="$1"
  local candidates=(
    "${_ccr_script_dir}/lib/${name}"
    "${HOME}/.local/share/cc-router/lib/${name}"
  )
  for c in "${candidates[@]}"; do
    if [[ -f "$c" ]]; then
      # shellcheck source=/dev/null
      source "$c"
      return 0
    fi
  done
  echo "ccr: lib/${name} not found (re-run ./install.sh)" >&2
  return 1
}

ccr_load_libs() {
  _ccr_load_lib ccr-common.sh || exit 1
  _ccr_load_lib ccr-setup.sh || true
  _ccr_load_lib ccr-remote.sh || true
  _ccr_load_lib ccr-remote-config.sh || true
  _ccr_load_lib ccr-remote-ssh.sh || true
  _ccr_load_lib ccr-remote-skills.sh || true
}

show_help() {
  cat <<'EOF'
ccr - Code/Claude Router: unified launcher for Claude Code

Usage:
  ccr [claude args...]                    # official Claude mode (default)
  ccr claude [claude args...]             # official Claude mode
  ccr 9router [claude args...]            # 9Router / cache-fix mode
  ccr deepseek [options] [-- claude args] # DeepSeek mode
  ccr switch [claude args...]             # CC Switch proxy mode
  ccr kimi [claude args...]               # Kimi coding mode
  ccr remote <subcommand> [args...]       # remote server onboarding
  ccr setup [check|install-deps|start-cache-fix|intro]
  ccr config [show|setup|set|claude ...]
  ccr doctor [detail|-v|--verbose]
  ccr --help

Legacy aliases (deprecated):
  ccd → ccr deepseek
  ccs → ccr switch
  cck → ccr kimi

First-time stack:  ccr setup
Full guide:        ~/.local/share/cc-router/docs/SETUP-GUIDE.md
Remote guide:      ~/.local/share/cc-router/docs/CR-REMOTE.md
EOF
}

show_deepseek_help() {
  cat <<'EOF'
ccr deepseek - Start Claude Code routed to DeepSeek

Usage:
  ccr deepseek [options] [-- claude args...]
  ccr deepseek resume [claude args...]
  ccr deepseek doctor
  ccr deepseek setup
  ccr deepseek prompt [--print-prompt]

Options:
  -h, --help                 Show help
  --persist                  Write the deepseek env block to your shell profile (permanent)
  -C, --current, --here      Keep current directory
  --worktree <name>          Run in .worktrees/<name> (requires clean git repo)
  --model <id>               Default: deepseek-v4-pro[1m]
  --haiku-model <id>         Default: deepseek-v4-flash
  --max-output <n>           Default: 65536
  --autocompact-pct <n>      Default: 0 (unset override)
EOF
}

show_remote_help() {
  cat <<'EOF'
ccr remote - remote server Claude Code onboarding

Usage:
  ccr remote pack [--platforms linux-x64,linux-arm64] [--skip-download] [--vendor kimi|deepseek|anthropic|default]
  ccr remote install [-v|--verbose] [-n|--dry-run] <host|alias>  # install ccr itself on remote host via SSH
  ccr remote onboard [alias] [options]     # interactive all-in-one first-time onboarding
  ccr remote setup [alias] [options]       # selective configuration menu (default: sync)

  ccr remote push <host|alias>             # push current ccr scripts/templates to remote host
  ccr remote sync <host|alias>
  ccr remote ssh <host|alias> [claude args...]
  ccr remote config show
  ccr remote skills
  ccr remote ssh-config add <alias> <host> [user] [port] [key]
  ccr remote ssh-config list
  ccr remote doctor <host|alias>

Environment:
  CC_REMOTE_SETTINGS_MODE=local|remote|default
  CC_REMOTE_PACK_DIR=~/.local/share/cc-router/remote-pack
  CC_REMOTE_VENDOR=kimi|deepseek|anthropic|default
  CC_REMOTE_SYNC_SKILLS=0|1
  CC_REMOTE_AUTH_TOKEN=<ANTHROPIC_AUTH_TOKEN>
EOF
}

# -----------------------------------------------------------------------------
# DeepSeek mode
# -----------------------------------------------------------------------------

ccr_run_deepseek() {
  local model='deepseek-v4-pro[1m]' haiku_model='deepseek-v4-flash' max_output='65536' autocompact_pct='0'
  local worktree_name='' use_current_dir='0' persist='0' args=()
  local print_prompt=0 prompt_help=0

  if [[ $# -eq 0 ]]; then
    :
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help|help)
        show_deepseek_help
        exit 0
        ;;
      --persist)
        persist='1'; shift ;;
      doctor)
        ccr_deepseek_doctor
        exit $?
        ;;
      setup)
        ccr_deepseek_setup
        exit $?
        ;;
      prompt|dramatic-prompt)
        shift
        ccr_deepseek_prompt "$@"
        exit $?
        ;;
      -C|--here|--current)
        use_current_dir='1'; shift ;;
      --worktree)
        if [[ $# -lt 2 ]]; then ccr_die "--worktree requires a value" 2; fi
        worktree_name="$2"; shift 2 ;;
      --model)
        if [[ $# -lt 2 ]]; then ccr_die "--model requires a value" 2; fi
        model="$2"; shift 2 ;;
      --haiku-model)
        if [[ $# -lt 2 ]]; then ccr_die "--haiku-model requires a value" 2; fi
        haiku_model="$2"; shift 2 ;;
      --max-output)
        if [[ $# -lt 2 ]]; then ccr_die "--max-output requires a value" 2; fi
        max_output="$2"; shift 2 ;;
      --autocompact-pct)
        if [[ $# -lt 2 ]]; then ccr_die "--autocompact-pct requires a value" 2; fi
        autocompact_pct="$2"; shift 2 ;;
      resume)
        args+=("-c"); shift ;;
      --)
        shift; while [[ $# -gt 0 ]]; do args+=("$1"); shift; done ;;
      *)
        args+=("$1"); shift ;;
    esac
  done

  if [[ -n "${worktree_name}" && "${use_current_dir}" == "1" ]]; then
    ccr_die "--worktree cannot be used with --current/--here" 2
  fi

  if [[ -n "${worktree_name}" ]]; then
    if ! [[ -n "${worktree_name}" && "${worktree_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
      ccr_die "Invalid worktree name: use only letters, numbers, '.', '_' or '-'" 2
    fi
    local repo_root worktree_dir
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
      ccr_die "--worktree requires running inside a git repository" 2
    fi
    if [[ -n "$(git -C "${repo_root}" status --porcelain)" ]]; then
      ccr_die "Refusing to create/reuse worktree from a dirty repo. Commit/stash changes first." 2
    fi
    worktree_dir="$(ccr_ensure_worktree_path "${worktree_name}" "${repo_root}")"
    cd "${worktree_dir}"
  fi

  if ! command -v claude >/dev/null 2>&1; then
    ccr_die "Claude Code CLI not found. Install first: npm install -g @anthropic-ai/claude-code"
  fi

  if [[ -z "${DEEPSEEK_API_KEY:-}" ]]; then
    ccr_die "Set DEEPSEEK_API_KEY before running ccr deepseek."
  fi

  # Persist mode: write the deepseek env block into the shell profile and exit.
  if [[ "${persist}" == "1" ]]; then
    ccr_deepseek_persist_env "${model}" "${haiku_model}" "${max_output}" "${autocompact_pct}"
    echo "[ccr deepseek] 永久模式已配置。新开 shell 后直接运行 'claude' 即可。"
    return 0
  fi

  ccr_deepseek_export_env "${model}" "${haiku_model}" "${max_output}" "${autocompact_pct}"
  ccr_export_cache_prompt_env

  ccr_exec_claude "${args[@]}"
}

# Emit the deepseek env as `export KEY=VALUE` lines (single source for both
# temp-export and --persist). Honors the parsed model/haiku/max/autocompact values.
ccr_deepseek_env_lines() {
  local model="$1" haiku_model="$2" max_output="$3" autocompact_pct="$4"
  local ccd_tool_search="${CCD_TOOL_SEARCH-true}"
  cat <<EOF
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=${DEEPSEEK_API_KEY}
ANTHROPIC_API_KEY=${DEEPSEEK_API_KEY}
ANTHROPIC_MODEL=${model}
ANTHROPIC_DEFAULT_OPUS_MODEL=${model}
ANTHROPIC_DEFAULT_FABLE_MODEL=${model}
ANTHROPIC_DEFAULT_SONNET_MODEL=${model}
ANTHROPIC_DEFAULT_HAIKU_MODEL=${haiku_model}
CLAUDE_CODE_SUBAGENT_MODEL=${haiku_model}
CLAUDE_CODE_MAX_OUTPUT_TOKENS=${max_output}
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1
CLAUDE_CODE_EFFORT_LEVEL=max
EOF
  if [[ -n "${ccd_tool_search}" ]]; then
    printf 'ENABLE_TOOL_SEARCH=%s\n' "${ccd_tool_search}"
  fi
  if [[ "${autocompact_pct}" != "0" ]]; then
    printf 'CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=%s\n' "${autocompact_pct}"
  fi
}

# Export the deepseek env into the current (sub)shell.
ccr_deepseek_export_env() {
  local line
  while IFS='=' read -r line; do
    [[ -z "$line" ]] && continue
    export "$line"
  done < <(ccr_deepseek_env_lines "$@")
}

# Persist the deepseek env block into the user's shell profile (idempotent).
ccr_deepseek_persist_env() {
  local profile
  profile="$(ccr_vendor_profile_file)"
  touch "$profile"

  local begin="# >>> ccr deepseek (managed) >>>"
  local end="# <<< ccr deepseek (managed) <<<"

  if grep -qF "$begin" "$profile" 2>/dev/null; then
    local tmp
    tmp="$(mktemp)"
    awk -v b="$begin" -v e="$end" '
      $0 == b {skip=1; next}
      $0 == e {skip=0; next}
      skip != 1 {print}
    ' "$profile" >"$tmp"
    mv "$tmp" "$profile"
  fi

  {
    printf '%s\n' "$begin"
    printf '# deepseek env (persisted by `ccr deepseek --persist`). Delete this block to undo.\n'
    local line key val
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      key="${line%%=*}"
      val="${line#*=}"
      printf 'export %s=%q\n' "$key" "$val"
    done < <(ccr_deepseek_env_lines "$@")
    printf '%s\n' "$end"
  } >>"$profile"

  echo "[ccr deepseek] 已写入 ${profile}（重开 shell 或 source 后永久生效）"
}

ccr_die() {
  echo "$1" >&2
  exit "${2:-1}"
}

ccr_ensure_worktree_path() {
  local name="$1" repo_root="$2"
  local target_dir="${repo_root}/.worktrees/${name}"
  local branch_name="worktree/${name}"

  mkdir -p "${repo_root}/.worktrees"

  if [[ -d "${target_dir}" ]]; then
    local target_root
    if git -C "${target_dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      target_root="$(git -C "${target_dir}" rev-parse --show-toplevel 2>/dev/null || true)"
      if [[ "${target_root}" == "${target_dir}" ]]; then
        echo "${target_dir}"
        return 0
      fi
    fi
    ccr_die "Worktree path already exists but is not a reusable git worktree: ${target_dir}"
  fi

  if git -C "${repo_root}" show-ref --verify --quiet "refs/heads/${branch_name}"; then
    git -C "${repo_root}" worktree add "${target_dir}" "${branch_name}" >/dev/null
  else
    git -C "${repo_root}" worktree add -b "${branch_name}" "${target_dir}" >/dev/null
  fi
  echo "${target_dir}"
}

ccr_deepseek_doctor() {
  local issues=0
  echo "== ccr deepseek doctor =="
  echo "Target: DeepSeek routing mode"
  echo

  if [[ -n "${DEEPSEEK_API_KEY:-}" ]]; then
    echo "OK: DEEPSEEK_API_KEY detected in current shell"
  else
    issues=1
    echo "FAIL: DEEPSEEK_API_KEY is missing"
    echo "Fix (current shell): export DEEPSEEK_API_KEY=\"your_key\""
    echo "Fix (persist bash): echo 'export DEEPSEEK_API_KEY=\"your_key\"' >> ~/.bashrc && . ~/.bashrc"
  fi
  echo

  if command -v claude >/dev/null 2>&1; then
    echo "OK: claude found at $(command -v claude)"
  else
    issues=1
    echo "FAIL: claude not found in PATH"
    echo "Fix (npm): npm install -g @anthropic-ai/claude-code"
  fi
  echo

  echo "Expected env behavior for ccr deepseek:"
  echo "- ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN are injected only at launch"
  echo "- Outside this mode, these two vars are usually empty (this is normal)"

  if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
    if [[ "${ANTHROPIC_BASE_URL}" == "https://api.deepseek.com/anthropic" ]]; then
      echo "OK: current ANTHROPIC_BASE_URL matches runtime value"
    else
      issues=1
      echo "WARN: current ANTHROPIC_BASE_URL is unexpected: ${ANTHROPIC_BASE_URL}"
      echo "Fix: unset ANTHROPIC_BASE_URL"
    fi
  else
    echo "OK: ANTHROPIC_BASE_URL not preset in shell (normal)"
  fi

  if [[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
    if [[ -n "${DEEPSEEK_API_KEY:-}" && "${ANTHROPIC_AUTH_TOKEN}" == "${DEEPSEEK_API_KEY}" ]]; then
      echo "OK: current ANTHROPIC_AUTH_TOKEN matches DEEPSEEK_API_KEY"
    else
      issues=1
      echo "WARN: current ANTHROPIC_AUTH_TOKEN does not match DEEPSEEK_API_KEY"
      echo "Fix: unset ANTHROPIC_AUTH_TOKEN"
    fi
  else
    echo "OK: ANTHROPIC_AUTH_TOKEN not preset in shell (normal)"
  fi
  echo

  echo "MCP tool context-bloat protection (ENABLE_TOOL_SEARCH):"
  if [[ -z "${CCD_TOOL_SEARCH+x}" ]]; then
    echo "  ccr deepseek will inject ENABLE_TOOL_SEARCH=true (default)"
  elif [[ -z "${CCD_TOOL_SEARCH}" ]]; then
    echo "  ccr deepseek will NOT inject ENABLE_TOOL_SEARCH (CCD_TOOL_SEARCH explicitly empty)"
  else
    echo "  ccr deepseek will inject ENABLE_TOOL_SEARCH=${CCD_TOOL_SEARCH}"
  fi
  echo

  if [[ "${issues}" -eq 0 ]]; then
    echo "Doctor result: healthy"
  else
    echo "Doctor result: action required"
  fi
  exit 0
}

ccr_deepseek_setup() {
  local key choice doctor_choice profile="${HOME}/.bashrc" has_existing=0 line tmp_file export_line
  echo "DeepSeek setup"
  echo
  read -r -p "Enter DEEPSEEK_API_KEY: " key
  if [[ -z "${key}" ]]; then
    echo "DEEPSEEK_API_KEY cannot be empty." >&2
    exit 2
  fi

  echo
  echo "Choose persistence:"
  echo "  1) Current session only"
  echo "  2) Write to ~/.bashrc"
  read -r -p "Select [1/2]: " choice

  export_line="export DEEPSEEK_API_KEY=\"${key}\""
  case "${choice}" in
    1)
      echo
      echo "Current session only selected."
      echo "Run this command in your shell:"
      echo "${export_line}"
      ;;
    2)
      touch "${profile}"
      while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ "${line}" == export\ DEEPSEEK_API_KEY=* ]]; then has_existing=1; break; fi
      done < "${profile}"

      if [[ "${has_existing}" == '1' ]]; then
        tmp_file="$(mktemp)"
        while IFS= read -r line || [[ -n "${line}" ]]; do
          if [[ "${line}" == export\ DEEPSEEK_API_KEY=* ]]; then
            printf '%s\n' "${export_line}" >> "${tmp_file}"
          else
            printf '%s\n' "${line}" >> "${tmp_file}"
          fi
        done < "${profile}"
        mv "${tmp_file}" "${profile}"
        echo "Updated existing DEEPSEEK_API_KEY in ${profile}."
      else
        printf '\n%s\n' "${export_line}" >> "${profile}"
        echo "Appended DEEPSEEK_API_KEY to ${profile}."
      fi
      export DEEPSEEK_API_KEY="${key}"
      echo "Applied key to current shell process."
      ;;
    *)
      echo "Invalid selection: ${choice}" >&2
      exit 2
      ;;
  esac

  echo
  echo "Next steps:"
  echo "  1) Run: ccr deepseek doctor"
  echo "  2) Run: ccr deepseek"
  if command -v claude >/dev/null 2>&1; then
    echo
    read -r -p "Run 'ccr deepseek doctor' now? [Y/n]: " doctor_choice
    if [[ -z "${doctor_choice:-}" || "${doctor_choice}" == "y" || "${doctor_choice}" == "Y" ]]; then
      if [[ -n "${DEEPSEEK_API_KEY:-}" ]]; then
        echo
        echo "Running ccr deepseek doctor..."
        echo "OK: DEEPSEEK_API_KEY detected."
        echo "OK: claude found at $(command -v claude)"
      else
        echo "Cannot run doctor automatically in this shell context."
        echo "Please run manually: ccr deepseek doctor"
      fi
    fi
  else
    echo
    echo "claude not found yet. Install first, then run: ccr deepseek doctor"
  fi
}

ccr_deepseek_resolve_prompt_template() {
  if [[ -n "${CCD_PROMPT_TEMPLATE:-}" ]]; then
    if [[ -f "${CCD_PROMPT_TEMPLATE}" ]]; then
      printf '%s\n' "${CCD_PROMPT_TEMPLATE}"
      return 0
    fi
    echo "CCD_PROMPT_TEMPLATE is set but file does not exist: ${CCD_PROMPT_TEMPLATE}" >&2
    return 1
  fi

  local script_path="${BASH_SOURCE[0]}" link_target script_dir
  while [[ -L "${script_path}" ]]; do
    link_target="$(readlink "${script_path}")"
    if [[ "${link_target}" = /* ]]; then
      script_path="${link_target}"
    else
      script_path="$(cd "$(dirname "${script_path}")" && pwd)/${link_target}"
    fi
  done
  script_dir="$(cd "$(dirname "${script_path}")" && pwd)"

  local candidates=(
    "${script_dir}/../docs/dramatic-prompt.md"
    "${HOME}/.local/share/cc-router/templates/dramatic-prompt.md"
    "$(pwd)/docs/dramatic-prompt.md"
  )
  local c
  for c in "${candidates[@]}"; do
    if [[ -f "${c}" ]]; then
      printf '%s\n' "$(cd "$(dirname "${c}")" && pwd)/$(basename "${c}")"
      return 0
    fi
  done
  return 1
}

ccr_deepseek_prompt() {
  local print_prompt=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print-prompt|--print) print_prompt=1; shift ;;
      -h|--help)
        cat <<'EOF'
ccr deepseek prompt - Show the dramatic prompt template for AI-assisted setup

Usage:
  ccr deepseek prompt                  Print the template path and hints
  ccr deepseek prompt --print-prompt   Print the full template content

Template lookup:
  1. $CCD_PROMPT_TEMPLATE
  2. <script-dir>/../docs/dramatic-prompt.md
  3. ~/.local/share/cc-router/templates/dramatic-prompt.md
  4. ./docs/dramatic-prompt.md
EOF
        return 0 ;;
      *)
        echo "Unknown option for 'ccr deepseek prompt': $1" >&2
        return 2 ;;
    esac
  done

  local template
  if ! template="$(ccr_deepseek_resolve_prompt_template)"; then
    cat >&2 <<'EOF'
Could not locate dramatic-prompt.md template.

Either:
  - set CCD_PROMPT_TEMPLATE=/absolute/path/to/dramatic-prompt.md
  - or place the file at ~/.local/share/cc-router/templates/dramatic-prompt.md
  - or run this command from a checkout that contains docs/dramatic-prompt.md
EOF
    return 1
  fi

  if [[ "${print_prompt}" -eq 1 ]]; then
    cat "${template}"
    return 0
  fi

  cat <<EOF
Dramatic prompt template:
  ${template}

Show full content:
  ccr deepseek prompt --print-prompt

Copy to clipboard:
  ccr deepseek prompt --print-prompt | pbcopy

Then paste it into any AI coding agent and follow the steps.
EOF
}

# -----------------------------------------------------------------------------
# CC Switch mode
# -----------------------------------------------------------------------------

ccr_switch_proxy_url() {
  if [[ -n "${CC_CCS_PROXY_URL:-}" ]]; then
    printf '%s\n' "${CC_CCS_PROXY_URL%/}"
    return 0
  fi
  ccr_config_get ccsProxyUrl "http://127.0.0.1:15721" | sed 's|/*$||'
}

ccr_switch_probe_health() {
  local base="${1%/}"
  curl -fsS --max-time 5 "${base}/health" >/dev/null 2>&1
}

ccr_switch_print_start_hint() {
  local url="$1"
  cat >&2 <<EOF
FAIL: CC Switch proxy not reachable at ${url}

Fix:
  1. Open CC Switch desktop app
  2. Click "Proxy" (top right) → "Start"
  3. Verify: curl -fsS ${url}/health

If your proxy is on a non-default port:
  CC_CCS_PROXY_URL=http://host:port ccr switch
  # or persist:
  ccr config set ccsProxyUrl http://host:port
EOF
}

ccr_run_switch() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
ccr switch - Start Claude Code via CC Switch proxy

Usage:
  ccr switch [claude args...]
  ccr switch resume [claude args...]
  ccr switch doctor [detail|-v|--verbose]
EOF
    exit 0
  fi

  if [[ "${1:-}" == "doctor" ]]; then
    shift
    ccr_switch_doctor "$@"
    exit $?
  fi

  if ! command -v claude >/dev/null 2>&1; then
    echo "Claude Code CLI not found. Install first: npm install -g @anthropic-ai/claude-code" >&2
    exit 1
  fi

  local proxy_url="$(ccr_switch_proxy_url)"
  if ! ccr_switch_probe_health "${proxy_url}"; then
    ccr_switch_print_start_hint "${proxy_url}"
    exit 1
  fi

  if [[ "${1:-}" == "resume" ]]; then
    shift
    set -- -c "$@"
  fi

  (
    ccr_unset_routing_env
    export ANTHROPIC_BASE_URL="${proxy_url}/v1"
    export ENABLE_TOOL_SEARCH="${CCS_TOOL_SEARCH-true}"
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1
    ccr_export_cache_prompt_env
    ccr_run_claude "$@"
  )
}

# -----------------------------------------------------------------------------
# Kimi mode
# -----------------------------------------------------------------------------

ccr_kimi_template_path() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local candidates=(
    "${script_dir}/../templates/remote/kimi.json"
    "${HOME}/.local/share/cc-router/templates/remote/kimi.json"
  )
  for c in "${candidates[@]}"; do
    if [[ -f "$c" ]]; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  echo "ccr kimi: templates/remote/kimi.json not found (re-run ./install.sh)" >&2
  return 1
}

ccr_kimi_bootstrap_path() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local candidates=(
    "${script_dir}/../templates/remote/kimi-bootstrap.js"
    "${HOME}/.local/share/cc-router/templates/remote/kimi-bootstrap.js"
  )
  for c in "${candidates[@]}"; do
    if [[ -f "$c" ]]; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

# Run the official Kimi-for-coding onboarding bootstrap (idempotent).
# Enables third-party model support, marks onboarding complete, and removes
# stale model-id env keys from ~/.claude/settings.json.
ccr_kimi_bootstrap() {
  local script
  script="$(ccr_kimi_bootstrap_path)" || {
    echo "WARN: kimi-bootstrap.js not found, skipping onboarding bootstrap" >&2
    return 0
  }
  if ! command -v node >/dev/null 2>&1; then
    echo "WARN: node not found, skipping kimi onboarding bootstrap" >&2
    return 0
  fi
  node "$script"
}

# ---------------- Generic vendor env helpers (shared by kimi/deepseek/...) ----------------

# Resolve a vendor API token from local settings or env.
# Usage: ccr_vendor_token <extra-env-var...>   (e.g. ccr_vendor_token DEEPSEEK_API_KEY)
# Order: settings.json env.ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY, then each named env var,
# then generic ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY.
ccr_vendor_token() {
  local token=""
  if [[ -f "${HOME}/.claude/settings.json" ]] && command -v jq >/dev/null 2>&1; then
    token="$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // .env.ANTHROPIC_API_KEY // empty' "${HOME}/.claude/settings.json" 2>/dev/null || true)"
  fi
  local var
  for var in "$@"; do
    if [[ -z "${token}" && -n "${!var:-}" ]]; then
      token="${!var}"
    fi
  done
  if [[ -z "${token}" && -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
    token="${ANTHROPIC_AUTH_TOKEN}"
  fi
  if [[ -z "${token}" && -n "${ANTHROPIC_API_KEY:-}" ]]; then
    token="${ANTHROPIC_API_KEY}"
  fi
  printf '%s\n' "$token"
}

# Shell profile to persist env into (bash/zsh).
ccr_vendor_profile_file() {
  if [[ -n "${ZSH_VERSION:-}" || "${SHELL:-}" == */zsh ]]; then
    printf '%s\n' "${HOME}/.zshrc"
  else
    printf '%s\n' "${HOME}/.bashrc"
  fi
}

# Persist a vendor env block into the user's shell profile (idempotent).
# Usage: ccr_vendor_persist_env <vendor> <template.json> <token>
ccr_vendor_persist_env() {
  local vendor="$1" template="$2" token="$3"
  local profile
  profile="$(ccr_vendor_profile_file)"
  touch "$profile"

  local begin="# >>> ccr ${vendor} (managed) >>>"
  local end="# <<< ccr ${vendor} (managed) <<<"

  # Remove any previous managed block for this vendor.
  if grep -qF "$begin" "$profile" 2>/dev/null; then
    local tmp
    tmp="$(mktemp)"
    awk -v b="$begin" -v e="$end" '
      $0 == b {skip=1; next}
      $0 == e {skip=0; next}
      skip != 1 {print}
    ' "$profile" >"$tmp"
    mv "$tmp" "$profile"
  fi

  {
    printf '%s\n' "$begin"
    printf '# %s env (persisted by `ccr %s --persist`). Delete this block to undo.\n' "$vendor" "$vendor"
    # Emit env exports from the template, substituting the resolved token.
    while IFS='=' read -r key val; do
      [[ -z "$key" ]] && continue
      if [[ "$key" == "ANTHROPIC_AUTH_TOKEN" || "$key" == "ANTHROPIC_API_KEY" ]]; then
        val="$token"
      fi
      printf 'export %s=%q\n' "$key" "$val"
    done < <(jq -r '.env | to_entries[] | "\(.key)=\(.value)"' "$template")
    # Also export ANTHROPIC_API_KEY alias for tools that read it instead.
    printf 'export ANTHROPIC_API_KEY=%q\n' "$token"
    printf '%s\n' "$end"
  } >>"$profile"

  echo "[ccr ${vendor}] 已写入 ${profile}（重开 shell 或 source 后永久生效）"
}

# Back-compat shims for the old kimi-specific names.
ccr_kimi_token() { ccr_vendor_token; }
ccr_kimi_profile_file() { ccr_vendor_profile_file; }
ccr_kimi_persist_env() { ccr_vendor_persist_env "kimi" "$@"; }

ccr_run_kimi() {
  local persist=0 do_bootstrap=1
  local passthrough=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|help|-h)
        cat <<'EOF'
ccr kimi - Start Claude Code routed to Kimi coding API

Usage:
  ccr kimi [options] [claude args...]
  ccr kimi resume [claude args...]

Options:
  --persist        Write the kimi env block into your shell profile (permanent)
  --no-bootstrap   Skip the onboarding bootstrap (default: run it, idempotent)

Model tiers (Allegretto+):
  Opus / Fable            -> k3[1m]            (1M context)
  Sonnet / Haiku / Agent  -> kimi-for-coding-highspeed

Token: read from ~/.claude/settings.json (env.ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY)
or from the ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY environment variable.
EOF
        exit 0
        ;;
      --persist) persist=1; shift ;;
      --no-bootstrap) do_bootstrap=0; shift ;;
      *) passthrough+=("$1"); shift ;;
    esac
  done
  set -- "${passthrough[@]}"

  if ! command -v claude >/dev/null 2>&1; then
    echo "Claude Code CLI not found. Install first: npm install -g @anthropic-ai/claude-code" >&2
    exit 1
  fi

  local template token
  template="$(ccr_kimi_template_path)" || exit 1
  token="$(ccr_kimi_token)"

  if [[ -z "${token}" ]]; then
    echo "ERROR: 未找到 Kimi token。" >&2
    echo "  请将 token 放入 ~/.claude/settings.json 的 env.ANTHROPIC_AUTH_TOKEN," >&2
    echo "  或 export ANTHROPIC_AUTH_TOKEN=<你的 Kimi API Key> 后重试。" >&2
    exit 1
  fi

  # Onboarding bootstrap (skip login, clean stale model keys). Idempotent.
  if [[ "$do_bootstrap" -eq 1 ]]; then
    ccr_kimi_bootstrap || true
  fi

  # Persist mode: write env block to profile and exit (do not launch claude).
  if [[ "$persist" -eq 1 ]]; then
    ccr_kimi_persist_env "$template" "$token"
    echo "[ccr kimi] 永久模式已配置。新开 shell 后直接运行 'claude' 即可。"
    return 0
  fi

  if [[ "${1:-}" == "resume" ]]; then
    shift
    set -- -c "$@"
  fi

  (
    ccr_unset_routing_env
    # Load all env keys from the Kimi template (temp, current process only).
    while IFS='=' read -r key val; do
      [[ -z "$key" ]] && continue
      if [[ "$key" == "ANTHROPIC_AUTH_TOKEN" ]]; then
        val="$token"
      fi
      export "$key=$val"
    done < <(jq -r '.env | to_entries[] | "\(.key)=\(.value)"' "$template")
    export ANTHROPIC_AUTH_TOKEN="${token}"
    export ANTHROPIC_API_KEY="${token}"
    ccr_export_cache_prompt_env
    ccr_run_claude "$@"
  )
}

ccr_switch_doctor() {
  local issues=0 detail_mode=0 arg
  for arg in "$@"; do
    case "${arg}" in
      detail|--detail|-d|--verbose|-v) detail_mode=1 ;;
    esac
  done

  echo "ccr switch doctor"
  echo

  echo "  Claude Code"
  if command -v claude >/dev/null 2>&1; then
    echo "  OK: claude found at $(command -v claude)"
  else
    issues=1
    echo "  FAIL: claude not found in PATH"
  fi
  echo

  local proxy_url="$(ccr_switch_proxy_url)"
  echo "  CC Switch proxy"
  echo "    URL: ${proxy_url}"
  if ccr_switch_probe_health "${proxy_url}"; then
    echo "    OK: reachable at ${proxy_url}/health"
  else
    issues=1
    echo "    FAIL: not reachable at ${proxy_url}"
  fi
  echo

  echo "  Environment"
  if ccr_cache_prompt_env_enabled; then
    echo "    cachePromptEnvEnabled: on"
  else
    echo "    cachePromptEnvEnabled: off"
  fi
  echo

  if [[ "${detail_mode}" -eq 1 ]]; then
    echo "  Effective env that 'ccr switch' would inject"
    echo "    ANTHROPIC_BASE_URL=${proxy_url}/v1"
    echo "    ENABLE_TOOL_SEARCH=${CCS_TOOL_SEARCH-true}"
  fi

  if [[ "${issues}" -eq 0 ]]; then
    echo "Doctor result: healthy"
  else
    echo "Doctor result: action required"
  fi
  exit 0
}

# -----------------------------------------------------------------------------
# Remote mode dispatch
# -----------------------------------------------------------------------------

ccr_remote_dispatch() {
  local cmd="${1:-help}"
  shift || true

  if [[ "${cmd}" == "-h" || "${cmd}" == "--help" || "${cmd}" == "help" ]]; then
    show_remote_help
    exit 0
  fi

  case "$cmd" in
    pack)
      ccr_remote_pack "$@"
      ;;
    install)
      local host="${1:-}"
      if [[ -z "$host" ]]; then
        echo "ERROR: 请指定远程主机或 SSH 别名" >&2
        echo "用法: ccr remote install <host|alias>" >&2
        exit 1
      fi
      shift
      ccr_remote_install "$host" "$@"
      ;;
    onboard)
      if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
        ccr_remote_setup_show_help "onboard"
        exit 0
      fi
      ccr_remote_onboard "$@"
      ;;
    setup)
      if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
        ccr_remote_setup_show_help "setup"

        exit 0
      fi
      ccr_remote_setup "$@"
      ;;
    push)
      local host="${1:-}"
      if [[ -z "$host" ]]; then
        echo "ERROR: 请指定远程主机或 SSH 别名" >&2
        echo "用法: ccr remote push <host|alias>" >&2
        exit 1
      fi
      ccr_remote_push "$host"
      ;;
    sync)
      local host="${1:-}"
      if [[ -z "$host" ]]; then
        echo "ERROR: 请指定远程主机或 SSH 别名" >&2
        exit 1
      fi
      ccr_remote_sync "$host"
      ;;
    ssh|connect)
      local host="${1:-}"
      if [[ -z "$host" ]]; then
        echo "ERROR: 请指定远程主机或 SSH 别名" >&2
        exit 1
      fi
      shift
      ccr_remote_ssh "$host" "$@"
      ;;
    config)
      local subcmd="${1:-generate}"
      shift || true
      case "$subcmd" in
        generate|gen|""|show) ccr_remote_config_generate ;;
        *) echo "ERROR: 未知 config 子命令: $subcmd" >&2; exit 1 ;;
      esac
      ;;
    skills)
      ccr_remote_skills_select
      ;;
    ssh-config)
      local subcmd="${1:-list}"
      shift || true
      case "$subcmd" in
        add) ccr_remote_ssh_config_add "$@" ;;
        list|ls) ccr_remote_ssh_config_list ;;
        *) echo "ERROR: 未知 ssh-config 子命令: $subcmd" >&2; exit 1 ;;
      esac
      ;;
    doctor)
      local host="${1:-}"
      if [[ -z "$host" ]]; then
        echo "ERROR: 请指定远程主机或 SSH 别名" >&2
        exit 1
      fi
      ccr_remote_doctor "$host"
      ;;
    *)
      echo "ERROR: 未知命令: $cmd" >&2
      show_remote_help
      exit 1
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Main dispatch
# -----------------------------------------------------------------------------

main() {
  ccr_load_libs

  if [[ $# -eq 0 ]]; then
    ccr_run_official_claude
    return $?
  fi

  local sub="${1:-}"
  shift || true

  case "$sub" in
    -h|--help|help)
      show_help
      exit 0
      ;;
    config)
      ccr_config_dispatch "$@"
      exit $?
      ;;
    setup)
      if ! declare -F ccr_setup_dispatch >/dev/null 2>&1; then
        echo "ccr: lib/ccr-setup.sh not found (re-run ./install.sh)" >&2
        exit 1
      fi
      ccr_setup_dispatch "$@"
      exit $?
      ;;
    doctor)
      local mode="official"
      if [[ "${1:-}" == "9router" || "${1:-}" == "-9" || "${1:-}" == "--9router" ]]; then
        mode="9router"
        shift
      fi
      ccr_doctor "$mode" "$@"
      exit $?
      ;;
    claude)
      ccr_run_official_claude "$@"
      exit $?
      ;;
    9router|-9|--9router)
      if [[ "${1:-}" == "doctor" ]]; then
        shift
        ccr_doctor 9router "$@"
        exit $?
      fi
      local nr_base nr_opus nr_sonnet nr_haiku nr_tool_search nr_key
      nr_base="$(ccr_ninerouter_real_url)"
      nr_opus="${NINEROUTER_OPUS_MODEL:-cc-pro}"
      nr_sonnet="${NINEROUTER_SONNET_MODEL:-cc-normal}"
      nr_haiku="${NINEROUTER_HAIKU_MODEL:-cc-lite}"
      nr_tool_search="${NINEROUTER_TOOL_SEARCH-true}"
      nr_key="${NINEROUTER_KEY:-}"
      ccr_run_9router_claude "$nr_base" "$nr_opus" "$nr_sonnet" "$nr_haiku" "$nr_tool_search" "$nr_key" "$@"
      exit $?
      ;;
    deepseek|d)
      ccr_run_deepseek "$@"
      exit $?
      ;;
    switch|s)
      ccr_run_switch "$@"
      exit $?
      ;;
    kimi|k)
      ccr_run_kimi "$@"
      exit $?
      ;;
    remote|r)
      ccr_remote_dispatch "$@"
      exit $?
      ;;
    *)
      # Default: treat as official claude with the original arg preserved
      set -- "$sub" "$@"
      ccr_run_official_claude "$@"
      exit $?
      ;;
  esac
}

main "$@"
