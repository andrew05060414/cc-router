#!/usr/bin/env bash
set -euo pipefail

# ccs — Start Claude Code via CC Switch proxy
#
# Parallel to 'cc' (official / cache-fix) and 'cc -9' (9Router direct).
# For users who route everything through CC Switch (no Anthropic account,
# or who want CC Switch's apiFormat conversion / model mapping / failover
# in the middle of the request path).

_ccs_script_path="${BASH_SOURCE[0]}"
while [[ -L "${_ccs_script_path}" ]]; do
  _ccs_link="$(readlink "${_ccs_script_path}")"
  if [[ "${_ccs_link}" = /* ]]; then
    _ccs_script_path="${_ccs_link}"
  else
    _ccs_script_path="$(cd "$(dirname "${_ccs_script_path}")" && pwd)/${_ccs_link}"
  fi
done
_ccs_script_dir="$(cd "$(dirname "${_ccs_script_path}")" && pwd)"
_ccs_lib_loaded=0
for _ccs_lib in "${_ccs_script_dir}/lib/cc-common.sh" "${HOME}/.local/share/cc-router/lib/cc-common.sh"; do
  if [[ -f "${_ccs_lib}" ]]; then
    # shellcheck source=/dev/null
    source "${_ccs_lib}"
    _ccs_lib_loaded=1
    break
  fi
done
if [[ "${_ccs_lib_loaded}" -ne 1 ]]; then
  echo "cc-router: lib/cc-common.sh not found (re-run ./install.sh)" >&2
  exit 1
fi

# CC Switch proxy URL (override with CC_CCS_PROXY_URL or 'cc config set ccsProxyUrl <url>').
ccs_proxy_url() {
  if [[ -n "${CC_CCS_PROXY_URL:-}" ]]; then
    printf '%s\n' "${CC_CCS_PROXY_URL%/}"
    return 0
  fi
  cc_router_config_get ccsProxyUrl "http://127.0.0.1:15721" | sed 's|/*$||'
}

ccs_probe_health() {
  local base="${1%/}"
  # CC Switch's /health returns HTTP 200 with {"status":"healthy",...}
  # (see src-tauri/src/proxy/handlers.rs::health_check in the cc-switch repo).
  # curl -f exits non-zero on 4xx/5xx, so a successful run already means the
  # proxy is up. No body inspection needed.
  curl -fsS --max-time 5 "${base}/health" >/dev/null 2>&1
}

ccs_print_start_hint() {
  local url="$1"
  cat >&2 <<EOF
FAIL: CC Switch proxy not reachable at ${url}

Fix:
  1. Open CC Switch desktop app
  2. Click "Proxy" (top right) → "Start"
  3. Verify: curl -fsS ${url}/health

If your proxy is on a non-default port:
  CC_CCS_PROXY_URL=http://host:port ccs
  # or persist:
  cc config set ccsProxyUrl http://host:port
EOF
}

show_help() {
  cat <<'EOF'
ccs - Start Claude Code via CC Switch proxy

Usage:
  ccs [claude args...]
  ccs resume [claude args...]
  ccs doctor [detail|-v|--verbose]
  ccs --help

CC Switch proxy must be running (default http://127.0.0.1:15721).
Authentication, model mapping (claude-* → ANTHROPIC_DEFAULT_*_MODEL),
apiFormat conversion (anthropic ↔ openai_chat/responses/gemini_native),
failover, and circuit-breaker are all handled by CC Switch itself.
This launcher only sets ANTHROPIC_BASE_URL and the prompt cache
hygiene env vars.

Override proxy URL:
  CC_CCS_PROXY_URL=http://host:port ccs
  cc config set ccsProxyUrl http://host:port
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "help" || "${1:-}" == "-h" ]]; then
  show_help
  exit 0
fi

if [[ "${1:-}" == "doctor" ]]; then
  issues=0
  detail_mode=0
  for arg in "${@:2}"; do
    case "${arg}" in
      detail|--detail|-d|--verbose|-v) detail_mode=1 ;;
    esac
  done

  echo "ccs doctor"
  echo

  echo "  ccs"
  ccs_src_self="${_ccs_script_dir}/ccs"
  ccs_on_path="$(command -v ccs 2>/dev/null || true)"
  cc_router_doctor_item "├" ""    "Source"        "${ccs_src_self}"
  if [[ -n "${ccs_on_path}" ]]; then
    cc_router_doctor_item "└" ""  "Resolved on PATH" "${ccs_on_path}"
  else
    issues=1
    cc_router_doctor_item "└" "fail" "Resolved on PATH" "not on PATH"
    cc_router_doctor_detail \
      "Fix: re-run ./install.sh in the cc-router repo," \
      "     or:  export PATH=\"\$HOME/.local/bin:\$PATH\""
  fi
  echo

  echo "  Claude Code"
  if command -v claude >/dev/null 2>&1; then
    claude_path="$(command -v claude)"
    claude_ver="$(claude --version 2>/dev/null | head -1 || true)"
    if [[ -z "${claude_ver}" ]]; then
      claude_ver="(version unknown)"
    fi
    cc_router_doctor_item "├" "ok" "Found"   "${claude_path}"
    cc_router_doctor_item "└" ""   "Version" "${claude_ver}"
  else
    issues=1
    cc_router_doctor_item "└" "fail" "Found"   "not in PATH"
    cc_router_doctor_detail \
      "Fix (npm):  npm install -g @anthropic-ai/claude-code" \
      "Fix (pnpm): pnpm add -g @anthropic-ai/claude-code"
  fi
  echo

  proxy_url="$(ccs_proxy_url)"
  echo "  CC Switch proxy"
  cc_router_doctor_item "├" ""   "URL"    "${proxy_url}"
  if ccs_probe_health "${proxy_url}"; then
    cc_router_doctor_item "└" "ok" "Health" "reachable at ${proxy_url}/health"
  else
    issues=1
    cc_router_doctor_item "└" "fail" "Health" "not reachable at ${proxy_url}"
    cc_router_doctor_detail \
      "Fix:" \
      "  1. Open CC Switch desktop app" \
      "  2. Click \"Proxy\" (top right) → \"Start\"" \
      "  3. Verify:  curl -fsS ${proxy_url}/health" \
      "If on a non-default port:" \
      "  cc config set ccsProxyUrl http://host:port"
  fi
  echo

  echo "  Environment"
  if cc_router_cache_prompt_env_enabled; then
    cc_router_doctor_item "├" "ok" "cachePromptEnvEnabled" "on (injects ATTRIBUTION/DISABLE_GIT)"
  else
    cc_router_doctor_item "├" "info" "cachePromptEnvEnabled" "off"
  fi
  if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
    cc_router_doctor_item "├" "warn" "ANTHROPIC_BASE_URL" "${ANTHROPIC_BASE_URL} (will be overwritten by ccs)"
  else
    cc_router_doctor_item "├" ""     "ANTHROPIC_BASE_URL" "(unset, ccs will set it)"
  fi
  if [[ -n "${NINEROUTER_URL:-}" ]]; then
    cc_router_doctor_item "└" "info" "NINEROUTER_URL"     "${NINEROUTER_URL%/} (used by 'cc -9', not by ccs)"
  else
    cc_router_doctor_item "└" ""     "NINEROUTER_URL"     "(unset, ignored by ccs)"
  fi
  echo

  if [[ "${detail_mode}" -eq 1 ]]; then
    echo "  Chain"
    echo "    Claude Code → CC Switch proxy (${proxy_url}) → upstream (configured in CC Switch)"
    echo

    echo "  Effective env that 'ccs' would inject"
    cc_router_doctor_item "├" "" "ANTHROPIC_BASE_URL"                   "${proxy_url}/v1"
    cc_router_doctor_item "├" "" "ANTHROPIC_AUTH_TOKEN"                 "(unset, CC Switch uses its DB token)"
    cc_router_doctor_item "├" "" "ENABLE_TOOL_SEARCH"                   "${CCS_TOOL_SEARCH-true}"
    cc_router_doctor_item "├" "" "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" "1"
    cc_router_doctor_item "├" "" "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK" "1"
    if cc_router_cache_prompt_env_enabled; then
      cc_router_doctor_item "├" "" "CLAUDE_CODE_ATTRIBUTION_HEADER"     "${CC_ATTRIBUTION_HEADER-false}"
      cc_router_doctor_item "└" "" "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS" "${CC_DISABLE_GIT_INSTRUCTIONS-1}"
    else
      cc_router_doctor_item "└" "" "cache-prompt-env"                   "(disabled, nothing injected)"
    fi
    echo

    echo "  What CC Switch proxy does (so ccs does not need to)"
    echo "    ├ Model mapping:"
    echo "    │   claude-sonnet-4-X → ANTHROPIC_DEFAULT_SONNET_MODEL"
    echo "    │   claude-haiku-4-X  → ANTHROPIC_DEFAULT_HAIKU_MODEL"
    echo "    │   claude-opus-4-X   → ANTHROPIC_DEFAULT_OPUS_MODEL"
    echo "    │   unknown           → ANTHROPIC_MODEL"
    echo "    │   (values come from the active Provider's settings_config in CC Switch DB,"
    echo "    │    NOT from ~/.claude/settings.json)"
    echo "    ├ apiFormat conversion:  anthropic ↔ openai_chat / openai_responses / gemini_native"
    echo "    ├ Failover + circuit-breaker (when more than one Provider account is configured)"
    echo "    └ Per-request usage logging (cache_read/creation_tokens, latency, cost)"
    echo

    echo "  What ccs intentionally does NOT do"
    echo "    ├ Cache-fix chaining: without an Anthropic account, prefix cache"
    echo "    │   normalization has no effect. If you later route to Anthropic via"
    echo "    │   'cc -9', enable cacheFix9routerEnabled separately."
    echo "    └ Model slot alias rewrite: CC Switch proxy expects the canonical"
    echo "        'claude-*' name to drive its model mapping. Slot aliases are a"
    echo "        9Router-direct feature ('cc -9' only)."
  fi

  echo
  if [[ "${issues}" -eq 0 ]]; then
    echo "  Result"
    cc_router_doctor_item "└" "ok" "Doctor" "healthy — ready to run 'ccs'"
  else
    echo "  Result"
    cc_router_doctor_item "└" "fail" "Doctor" "action required (see above)"
  fi
  exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "Claude Code CLI not found. Install first: npm install -g @anthropic-ai/claude-code" >&2
  exit 1
fi

proxy_url="$(ccs_proxy_url)"
if ! ccs_probe_health "${proxy_url}"; then
  ccs_print_start_hint "${proxy_url}"
  exit 1
fi

if [[ "${1:-}" == "resume" ]]; then
  shift
  set -- -c "$@"
fi

(
  cc_router_unset_routing_env
  export ANTHROPIC_BASE_URL="${proxy_url}/v1"
  # ENABLE_TOOL_SEARCH: same rationale as 'cc -9'. Claude Code >= 2.1.70 disables
  # deferred MCP tool loading when ANTHROPIC_BASE_URL points at a non-first-party
  # host; setting this back on forces it. Requires CC Switch proxy to forward
  # tool_reference blocks. Set CCS_TOOL_SEARCH='' or =auto to fall back.
  export ENABLE_TOOL_SEARCH="${CCS_TOOL_SEARCH-true}"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1
  cc_router_export_cache_prompt_env
  cc_router_run_claude "$@"
)
